#שזה יתפוס אוטומטית את ממשק ה-default route 

sudo bash -c '
sysctl -w net.ipv4.ip_forward=1
DEF_IFACE=$(ip route show | awk "/default/ {print \$5; exit}")
iptables -t nat -F POSTROUTING
iptables -F FORWARD
iptables -t nat -A POSTROUTING -o "$DEF_IFACE" -j MASQUERADE
iptables -A FORWARD -i tap0 -o "$DEF_IFACE" -j ACCEPT
iptables -A FORWARD -i "$DEF_IFACE" -o tap0 -m state --state RELATED,ESTABLISHED -j ACCEPT
echo "NAT applied successfully on interface: $DEF_IFACE"
'

