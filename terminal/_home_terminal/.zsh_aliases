export VIRTUAL_ENV_DISABLE_PROMPT=1
setopt PROMPT_SUBST
PROMPT='(%~/.env) %B%F{green}%~%f%b %# '
VIRTUAL_ENV_PROMPT="($PWD) "


alias d='[ -d .env ] && echo "A .env directory already exists here!" || (echo "Creating virtual environment..." && python3 -m venv .env)'


alias de='if [ -f .env/bin/activate ]; then source .env/bin/activate; elif [ -f .env/.env/bin/activate ]; then source .env/.env/bin/activate; else source ~/.env/.env/bin/activate; fi'

alias dee='deactivate'

# יצירת סביבה (או שימוש קיימת), הפעלה ושדרוג מלא תואם לוגיקת .env
alias pyin='if [ ! -d .env ]; then python3 -m venv .env; fi; if [ -f .env/bin/activate ]; then source .env/bin/activate; else source ~/.env/.env/bin/activate; fi; python -m pip install --upgrade pip setuptools wheel'
# ניקוי והסרה של כל סוגי הסביבות המקומיות (.env או .venv)
alias pyout='deactivate 2>/dev/null; rm -rf .env .venv'

#alias pyin='python3 -m venv .venv && source .venv/bin/activate && python -m pip install --upgrade pip'
#alias pyout='deactivate 2>/dev/null; rm -rf .venv'


