#cd() {
#    __zoxide_z "$@" && /usr/bin/ls --color -ACF
#}

cd() {
    __zoxide_z "$@" 
}



man() {
  command man "$@"  | sed '/output version information and exit/q'  |  batcat --language=help --color=always --paging=never | less -R -X -F --mouse 
}










my-pip() {
  cd ~/.env || return
  source ~/.env/.env/bin/activate
  echo " Virtualenv activated in myapp"
}







whereis() {
  command whereis "$@"
  echo "---- whence -v ----"
  whence -v "$@"
  echo "----- where ----"
  where "$@"
}








source /etc/grc.zsh
#alias ls='/usr/bin/ls --color -F'
#alias ll='/usr/bin/ls --color -aF'



#export PATH="/home/qwe/.env/.env/bin:$PATH"



h () {
{
"$@" -h 2>/dev/null |
"$@" --h 2>/dev/null |
"$@" -help 2>/dev/null |
"$@" --help 2>/dev/null } | 
awk 'NF' | grep '^[[:space:]]*-'  |
batcat --language=help --color=always --paging=never --style=plain

return 
}













