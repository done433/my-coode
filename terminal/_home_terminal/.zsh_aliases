# יוצרים widget חדש שמריץ kill -9 על ה-shell הנוכחי
function kill-shell-immediately() {
  #kill -9 -P $$
  pstree -p $$ | grep -oP '\(\d+\)' | grep -oP '\d+' | xargs kill -9
}

# הופכים אותו ל-widget של Zsh
zle -N kill-shell-immediately

# מקשרים ל-Ctrl+P
bindkey '^P' kill-shell-immediately



export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export LC_CTYPE=en_US.UTF-8


