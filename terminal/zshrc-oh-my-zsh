##  alias

alias q1q1='firejail --seccomp --noprofile --private bash'
alias q2q2='firejail --seccomp --private --private-dev --private-tmp --protocol=inet --noprofile bash'
alias w1w1='sudo rm -rf /etc/firejail/firejail.users ~/.local/share/applications/*.desktop ~/.cache/firejail ~/.config/firejail && sudo firecfg'
alias w2w2='sudo firecfg'
alias r4r4='sudo firecfg --clean'
alias e3e3='firejail --seccomp --private --private-dev --private-tmp --protocol=inet firefox --new-instance --no-remote --safe-mode --private-window'

alias tree='tree -a $(pwd)'



alias ls='/usr/bin/ls --color=auto'
alias dir='dir --color=auto'
alias vdir='vdir --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias ll='ls -lh'
alias la='ls -lha'
alias l='ls -CF'
alias ll='/usr/bin/ls -lah --color=auto'
