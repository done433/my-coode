

cd /var/lib/vz/template/iso/


wget https://builds.coreos.fedoraproject.org/prod/streams/stable/builds/44.20260913.3.2/x86_64/fedora-coreos-44.20260913.3.2-proxmoxve.x86_64.qcow2.xz




#===מה הבלוק הזה עושה: הכל מאפס===
#1. מוחק לגמרי את מכונה 1200: המכונה, הדיסק שלה וכונן ה-cloud-init שלה.
#2. מוחק את קבצי ה-Ignition הקודמים, כולל הגיבוי .bak.
#3. מוחק את ה-qcow2 שנפתח קודם, ופותח אותו מחדש מ-fadora.iso אחרי בדיקת שלמות.
#4. מבקש סיסמה חדשה למשתמש core.
#5. בונה Ignition חדש: משתמש core עם סיסמה ומפתח, ו-IP קבוע 10.10.10.40. בלי /etc/hostname, כי את השם fcos נותן Proxmox.
#6. יוצר את מכונה 1200 מחדש עם ההגדרות שבחרת: 1 core, cpu x86-64-v3, זיכרון 2176, רשת vmbr1, דיסק 20G. ואז מפעיל אותה.
#מה לא נוגעים בו: המכונות האחרות, הקובץ fadora.iso והדיסק sdb עם הגיבוי.

bash <<'EOF'
set -euo pipefail

#===הגדרות===
VMID=1200
NAME=fcos
SRC=/var/lib/vz/template/iso/fadora.iso
DIR=/var/lib/vz/template/fcos
QCOW=$DIR/fedora-coreos-44.20260913.3.2-proxmoxve.x86_64.qcow2
SNIPDIR=/var/lib/vz/snippets
IGN=fcos-$VMID.ign
PUB=/root/.ssh/id_ed25519-proxmax-vm.pub

#===בדיקות מקדימות===
[ -f "$SRC" ] || { echo "עצירה: לא נמצא $SRC"; exit 1; }
[ -f "$PUB" ] || { echo "עצירה: לא נמצא $PUB"; exit 1; }

#===מחיקה מלאה של מכונה 1200===
if qm status $VMID >/dev/null 2>&1; then
  qm stop $VMID || true
  qm destroy $VMID --purge
  echo "VM $VMID נמחקה"
fi

#===מחיקת קבצים ישנים===
rm -f "$SNIPDIR/$IGN" "$SNIPDIR/$IGN.bak"
rm -rf "$DIR"

#===פתיחה מחדש של התמונה מ-fadora.iso===
echo "בודק שהקובץ שלם..."
xz -t "$SRC"
mkdir -p "$DIR" "$SNIPDIR"
xz -d -c "$SRC" > "$QCOW"
file "$QCOW"

#===סיסמה חדשה למשתמש core===
#הסיסמה לא מוצגת בזמן ההקלדה
read -r -s -p "הקלד סיסמה חדשה למשתמש core: " PW < /dev/tty; echo
HASH=$(printf '%s' "$PW" | openssl passwd -6 -stdin)
unset PW
KEY=$(cat "$PUB")

#===יצירת Ignition חדש===
python3 - "$KEY" "$HASH" > "$SNIPDIR/$IGN" <<'PY'
import sys, json, urllib.parse
key, pw = sys.argv[1], sys.argv[2]
nm = """[connection]
id=ens18
type=ethernet
interface-name=ens18

[ipv4]
method=manual
addresses=10.10.10.40/24
gateway=10.10.10.1
dns=8.8.8.8;

[ipv6]
method=disabled
"""
print(json.dumps({
    "ignition": {"version": "3.4.0"},
    "passwd": {"users": [{"name": "core", "passwordHash": pw, "sshAuthorizedKeys": [key]}]},
    "storage": {"files": [{
        "path": "/etc/NetworkManager/system-connections/ens18.nmconnection",
        "mode": 384,
        "overwrite": True,
        "contents": {"source": "data:," + urllib.parse.quote(nm)}
    }]}
}, indent=2))
PY
chmod 600 "$SNIPDIR/$IGN"

#===snippets באחסון local===
#שומר את סוגי התוכן הקיימים ומוסיף להם snippets, אם עדיין לא קיים
CUR=$(awk '/^dir: local$/{f=1;next} f&&$1=="content"{print $2;exit}' /etc/pve/storage.cfg)
case ",$CUR," in *,snippets,*) ;; *) pvesm set local --content "$CUR,snippets";; esac

#===יצירת המכונה מחדש עם ההגדרות שלך===
qm create $VMID --name $NAME --memory 2176 --cores 1 --sockets 1 --cpu x86-64-v3 --ostype l26 \
  --net0 virtio,bridge=vmbr1 --scsihw virtio-scsi-pci \
  --scsi0 local:0,import-from="$QCOW",format=qcow2 \
  --boot order=scsi0 --serial0 socket
qm disk resize $VMID scsi0 20G

#===כונן cloud-init שמעביר את ה-Ignition===
qm set $VMID --ide2 local:cloudinit
qm set $VMID --cicustom vendor=local:snippets/$IGN

#===הצגת ההגדרות והפעלה===
qm config $VMID
qm start $VMID
echo "הכל הסתיים"
EOF




