VMID=4000
VMNAME=openwrt-lab
STORAGE=local

cd /var/lib/vz/template/iso

VER=$(curl -s https://downloads.openwrt.org/releases/ | grep -oE 'href="[0-9]+\.[0-9]+\.[0-9]+/"' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | sort -V | tail -1)
wget -O openwrt.img.gz "https://downloads.openwrt.org/releases/${VER}/targets/x86/64/openwrt-${VER}-x86-64-generic-ext4-combined.img.gz"
gunzip -f openwrt.img.gz || true
qm create $VMID --name $VMNAME --memory 256 --cores 1 --ostype l26 --scsihw virtio-scsi-pci --net0 virtio,bridge=vmbr1 --serial0 socket --vga serial0 --onboot 1
qm set $VMID --scsi0 ${STORAGE}:0,import-from=/var/lib/vz/template/iso/openwrt.img
qm set $VMID --boot order=scsi0



qm start $VMID
qm terminal $VMID







##to get  insernet and  ip addres
#on openwrt
uci set network.lan.proto='static'
uci set network.lan.ipaddr='10.10.10.50/24'
uci -q delete network.lan.netmask

uci set network.lan.gateway='10.10.10.1'


uci -q delete network.lan.dns
uci add_list network.lan.dns='1.1.1.1'
uci add_list network.lan.dns='9.9.9.9'


#===ביטול חלוקת IPv6 (לא שולט על הרשת)===
uci -q delete network.lan.ip6assign


#===מחיקת WAN אם קיים (אין כרטיס כזה)===
uci -q delete network.wan
uci -q delete network.wan6


#===ביטול שרת DHCP ו-RA כדי לא להפריע ל-VMs אחרים===
uci set dhcp.lan.ignore='1'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ra='disabled'
/etc/init.d/odhcpd disable
/etc/init.d/odhcpd stop


#===שמירה והפעלה מחדש של הרשת===
uci commit
service network restart
sleep 5


#and check
ip -4 addr show br-lan
ip r
ping -c 3 10.10.10.1
ping -c 3 9.9.9.9
ping -c 3 openwrt.org

